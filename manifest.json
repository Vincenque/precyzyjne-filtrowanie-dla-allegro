{
  "manifest_version": 3,
  "name": "Precyzyjne Filtrowanie dla Allegro",
  "version": "0.12",
  "description": "Precyzyjne filtry ocen dla Allegro. Głównym twórcą kodu jest AI, a autorem promptów Vincenque (https://github.com/Vincenque).",
  "homepage_url": "https://github.com/Vincenque/precyzyjne-filtrowanie-dla-allegro",
  "host_permissions": [
    "*://*.allegro.pl/*"
  ],
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.allegro.pl/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}